<Window x:Class="BlatmetroBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blatmetro Browser"
        Width="1280" Height="820" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="MenuActionButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MenuButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuButtonBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuButtonBorder" Property="Background"
                                        Value="{DynamicResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="58" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Border Grid.Row="0" Background="{DynamicResource TabStripBackground}" Padding="8,5,8,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="+" FontSize="21" Padding="9,1" ToolTip="Новая вкладка (Ctrl+T)"
                            Click="NewTab_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource ToolbarButton}"
                            Content="□" FontSize="16" Padding="9,1" ToolTip="Развернуть / восстановить окно"
                            Click="Maximize_Click" />
                    <Button x:Name="FullscreenButton" Style="{StaticResource ToolbarButton}"
                            Content="⛶" FontSize="19" Padding="9,1" ToolTip="Полноэкранный режим (F11)"
                            Click="Fullscreen_Click" />
                    <Button x:Name="MainMenuButton" Style="{StaticResource ToolbarButton}"
                            Content="⋮" FontSize="21" Padding="8,1" ToolTip="Меню браузера"
                            Click="MainMenuButton_Click" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabsStrip" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Navigation toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" Padding="10,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="←"
                            ToolTip="Назад" IsEnabled="False" Click="Back_Click" />
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolbarButton}" Content="→"
                            ToolTip="Вперёд" IsEnabled="False" Click="Forward_Click" />
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolbarButton}" Content="↻"
                            ToolTip="Обновить" Click="Reload_Click" />
                    <Button Style="{StaticResource ToolbarButton}" Content="⌂"
                            ToolTip="Домашняя страница" Click="Home_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SearchEngineBox" Width="204" Height="36" Margin="0,0,6,0"
                              VerticalContentAlignment="Center" ToolTip="Выбрать поисковую систему"
                              SelectionChanged="SearchEngineBox_SelectionChanged"
                              DropDownClosed="SearchEngineBox_DropDownClosed"
                              SelectedValuePath="Name"
                              ItemTemplate="{StaticResource SearchEngineItemTemplate}"
                              ItemContainerStyle="{StaticResource SearchEngineComboBoxItemStyle}"
                              Style="{StaticResource SearchEngineComboBoxStyle}" />
                    <ComboBox x:Name="ThemeModeBox" Width="126" Height="36" Margin="0,0,5,0"
                              VerticalContentAlignment="Center" ToolTip="Тема оформления браузера"
                              SelectedValuePath="Tag"
                              SelectionChanged="ThemeModeBox_SelectionChanged"
                              ItemContainerStyle="{StaticResource ThemeModeComboBoxItemStyle}"
                              Style="{StaticResource ThemeModeComboBoxStyle}">
                        <ComboBoxItem Content="Системная" Tag="System" />
                        <ComboBoxItem Content="Светлая" Tag="Light" />
                        <ComboBoxItem Content="Тёмная" Tag="Dark" />
                    </ComboBox>
                    <Button x:Name="BookmarkButton" Style="{StaticResource ToolbarButton}" Content="☆"
                            FontSize="20" ToolTip="Добавить или удалить закладку" Click="Bookmark_Click" />
                </StackPanel>

                <Border Margin="10,0" CornerRadius="10" Background="{DynamicResource AddressBackground}"
                        BorderBrush="{DynamicResource AddressBorder}" BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="20" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox x:Name="AddressBox" Style="{StaticResource AddressBoxStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ToolTip="Введите адрес сайта или поисковый запрос"
                                 KeyDown="AddressBox_KeyDown" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Bookmarks bar -->
        <Border Grid.Row="2" Background="{DynamicResource BookmarkBarBackground}"
                BorderBrush="{DynamicResource BookmarkBorder}" BorderThickness="0,0,0,1" Padding="12,3">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BookmarksPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>

        <!-- Browser surface -->
        <Grid x:Name="BrowserHost" Grid.Row="3" Background="#FFFFFF" />

        <Popup x:Name="MainMenuPopup" PlacementTarget="{Binding ElementName=MainMenuButton}"
               Placement="Bottom" HorizontalOffset="-250" VerticalOffset="3"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="286" Padding="7" CornerRadius="11"
                    Background="{DynamicResource SearchPopupBackground}"
                    BorderBrush="{DynamicResource SearchPopupBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Быстрые действия" Margin="10,5,10,7"
                               FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    <Button Style="{StaticResource MenuActionButton}" Click="NewTab_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="＋" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Новая вкладка" />
                            <TextBlock Grid.Column="2" Text="Ctrl+T"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuActionButton}" Click="Home_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="⌂" FontSize="15" />
                            <TextBlock Text="Домашняя страница" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuActionButton}" Click="Bookmark_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="☆" FontSize="15" />
                            <TextBlock Text="Добавить в закладки" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Margin="5,5" Background="{DynamicResource SearchPopupBorder}" />

                    <Grid Margin="8,3,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Масштаб" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MenuActionButton}" Content="−"
                                    MinWidth="34" Padding="8,3" Click="ZoomOut_Click"
                                    ToolTip="Уменьшить масштаб" />
                            <Button x:Name="ZoomResetButton" Style="{StaticResource MenuActionButton}"
                                    Content="100%" MinWidth="56" Padding="5,3" Click="ZoomReset_Click"
                                    ToolTip="Сбросить масштаб" />
                            <Button Style="{StaticResource MenuActionButton}" Content="+"
                                    MinWidth="34" Padding="8,3" Click="ZoomIn_Click"
                                    ToolTip="Увеличить масштаб" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource MenuActionButton}" Click="Fullscreen_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="26" Text="⛶" FontSize="14" />
                            <TextBlock Text="На весь экран" />
                            <TextBlock Text="F11" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Margin="5,5" Background="{DynamicResource SearchPopupBorder}" />

                    <Button Style="{StaticResource MenuActionButton}" IsEnabled="False"
                            ToolTip="Менеджер загрузок пока не реализован">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="Загрузки" />
                            <TextBlock Grid.Column="2" Text="Скоро"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                        </Grid>
                    </Button>
                    <TextBlock Text="Поисковик и тема — на панели браузера"
                               Margin="10,7,10,4" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
