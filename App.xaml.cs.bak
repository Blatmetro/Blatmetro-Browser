using System.IO;
using System.Windows;
using CefSharp;
using CefSharp.Wpf;

namespace BlatmetroBrowser;

public partial class App : Application
{
    private bool _cefInitialized;

    protected override void OnStartup(StartupEventArgs e)
    {
        base.OnStartup(e);

        var appData = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
            "Blatmetro",
            "Browser");

        Directory.CreateDirectory(appData);
        Directory.CreateDirectory(Path.Combine(appData, "Cache"));

        var subprocessPath = Environment.ProcessPath;
        if (string.IsNullOrWhiteSpace(subprocessPath))
        {
            MessageBox.Show(
                "Не удалось определить путь к исполняемому файлу Blatmetro Browser.",
                "Blatmetro Browser",
                MessageBoxButton.OK,
                MessageBoxImage.Error);
            Shutdown(-1);
            return;
        }

        var settings = new CefSettings
{
    CachePath = Path.Combine(appData, "Cache"),
    BrowserSubprocessPath = Environment.ProcessPath!,
    LogFile = Path.Combine(appData, "cef.log"),
    LogSeverity = LogSeverity.Verbose,
    Locale = "ru"
};

settings.CefCommandLineArgs.Add("do-not-de-elevate", "1");

        // Reduce optional Chromium background traffic. This does not disable
        // network requests initiated by websites opened by the user.
        settings.CefCommandLineArgs.Add("disable-background-networking", "1");
        settings.CefCommandLineArgs.Add("disable-component-update", "1");
        settings.CefCommandLineArgs.Add("disable-sync", "1");
        settings.CefCommandLineArgs.Add("disable-domain-reliability", "1");
        settings.CefCommandLineArgs.Add("disable-breakpad", "1");
        settings.CefCommandLineArgs.Add("no-first-run", "1");

        try
        {
            // Self-hosted CEF subprocesses are dispatched in Program.Main before
            // WPF starts, so CefSharp's dependency check must be disabled here.
            _cefInitialized = Cef.Initialize(
                settings,
                performDependencyCheck: false,
                browserProcessHandler: null);
        }
        catch (Exception ex)
        {
            MessageBox.Show(
                $"Не удалось запустить Chromium: {ex.Message}",
                "Blatmetro Browser",
                MessageBoxButton.OK,
                MessageBoxImage.Error);
            Shutdown(-1);
            return;
        }

        if (!_cefInitialized)
        {
            MessageBox.Show(
                $"Не удалось запустить Chromium. Код завершения: {Cef.GetExitCode()}",
                "Blatmetro Browser",
                MessageBoxButton.OK,
                MessageBoxImage.Error);
            Shutdown(-1);
            return;
        }

        var window = new MainWindow();
        MainWindow = window;
        window.Show();
    }

    protected override void OnExit(ExitEventArgs e)
    {
        if (_cefInitialized)
        {
            Cef.Shutdown();
        }

        base.OnExit(e);
    }
}
