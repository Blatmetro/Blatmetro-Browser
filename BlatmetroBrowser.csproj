<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseAppHost>true</UseAppHost>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>BlatmetroBrowser.Program</StartupObject>
    <AssemblyName>BlatmetroBrowser</AssemblyName>
    <RootNamespace>BlatmetroBrowser</RootNamespace>
    <Version>0.4.6</Version>
    <Product>Blatmetro Browser</Product>
    <Company>Blatmetro</Company>
    <Description>Chromium-based browser for BlatmetroOS development.</Description>
    <ApplicationIcon>Assets\BlatmetroBrowser.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="154.0.340" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\BlatmetroBrowser.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\NewTab.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Downloads.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>



<ItemGroup>
  <Content Include="Assets\SearchEngines\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>
</Project>
