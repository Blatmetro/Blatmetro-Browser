<Application x:Class="BlatmetroBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#10131B" />
        <SolidColorBrush x:Key="Surface" Color="#191E2A" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#252D3D" />
        <SolidColorBrush x:Key="SurfaceActive" Color="#303B50" />
        <SolidColorBrush x:Key="Accent" Color="#8B7CFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4FA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A6AEC0" />

        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="AddressBoxStyle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#202737" />
            <Setter Property="BorderBrush" Value="#30394B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
